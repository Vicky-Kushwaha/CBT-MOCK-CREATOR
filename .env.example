# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# ---- Postgres ----
POSTGRES_DB=cbt
POSTGRES_USER=cbt
POSTGRES_PASSWORD=cbt
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- Claude (question classification, answer inference, generation, explanations) ----
# Leave empty to run without AI: extracted questions stay unclassified until you
# tag them manually or connect Claude through the MCP server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Uploads / OCR ----
MAX_UPLOAD_MB=25
OCR_LANGS=eng+hin

# ---- MCP server ----
MCP_HOST=0.0.0.0
MCP_PORT=8811
